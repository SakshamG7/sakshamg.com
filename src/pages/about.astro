---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { ClientRouter } from 'astro:transitions';

const pageTitle = "My Story | Saksham Goel";
const pageDescription = "Learn about Saksham Goel's background, experience, education, and work in AI, software engineering, and hardware systems.";

const education = [
  {
    school: "Rochester Institute of Technology (RIT)",
    degree: "B.Sc. in Computer Science",
    location: "Rochester, NY, USA",
    period: "Aug 2025 - Present",
    gpa: "Dean's List",
    highlights: ["Electrical Team Member @ RIT Formula Racing (PCB Design)", "RIT AI Club Member", "RIT Cybersecurity Club Member", "RIT Chess Club Member", "RIT Badminton Club Member"]
  },
  {
    school: "White Oaks Secondary School",
    degree: "High School Diploma",
    location: "Oakville, ON, Canada",
    period: "Sep 2021 - Jun 2025",
    gpa: "Honor Roll",
    highlights: ["Founder @ Data Science & Machine Learning Club", "Programmer & Builder @ Engineering/Robotics Club", "DECA Inc. Member", "Competitive Computer Science Club Member", "Badminton Club Member"]
  }
];

const experience = [
  {
    role: "Software Engineer Intern",
    company: "Angstrom NA LLC",
    location: "Angstrom HQ · Full-time (On-site)",
    period: "May 2026 - Present · 2 mos",
    description: "Developing the Angstrom Company Website and creating/deploying AI agents.",
    points: [
      "Designing and developing the company website with modern responsive design and optimal SEO.",
      "Creating and deploying custom AI agents that automate administrative workflows, accelerating employee productivity.",
      "Optimizing cloud infrastructure on AWS, reducing operational website usage and platform hosting costs."
    ]
  },
  {
    role: "Chief Executive Officer & Founder",
    company: "AceIQ",
    location: "Toronto, ON, Canada (Hybrid)",
    period: "May 2024 - Present",
    description: "Building the bridge for businesses into the digital world through custom AI and web solutions.",
    points: [
      "Leveraged AWS (EC2, S3) for scalable backend infrastructures.",
      "Implemented advanced Linux hardening and custom sandboxing for high-security environments.",
      "Partnered with international clients like America's Ed and local gems like Spice & Saffron."
    ]
  },
  {
    role: "Student Member (Internship)",
    company: "Oakville Youth Council",
    location: "Oakville, ON, Canada (Hybrid)",
    period: "Sep 2023 - Aug 2025",
    description: "Helping to improve and make a positive impact on the local community.",
    points: [
      "Collaborated with community members and local non-profits to volunteer and support community service initiatives.",
      "Contributed to planning and executing youth-led projects for community improvement."
    ]
  },
  {
    role: "Founder & President",
    company: "Data Science and Machine Learning Club (WOSS)",
    location: "Oakville, ON, Canada (On-site)",
    period: "Jun 2024 - Jun 2025",
    description: "Founded and led the club to teach PyTorch and machine learning concepts.",
    points: [
      "Taught PyTorch and ML algorithms to high school students, fostering a community of AI enthusiasts.",
      "Developed hands-on curriculum covering data science, regression models, and neural networks."
    ]
  },
  {
    role: "Competitive Programmer & Builder",
    company: "White Oaks Engineering Club",
    location: "Oakville, ON, Canada (Hybrid)",
    period: "Sep 2023 - Jun 2025",
    description: "Competitive member of the Engineering/Robotics Team of White Oaks Secondary School.",
    points: [
      "Programmed and built competitive robotics models, integrating hardware and software interfaces.",
      "Utilized computer hardware skills and project management to coordinate assembly and debugging under tournament constraints."
    ]
  }
];

const extraCurriculars = [
  {
    role: "Electrical Team Member",
    org: "RIT Formula Racing",
    desc: "Working on low-level PCB design and electrical systems for high-performance racing."
  },
  {
    role: "Member",
    org: "RIT AI Club",
    desc: "Exploring modern developments and building projects in AI/ML."
  },
  {
    role: "Member",
    org: "RIT Cybersecurity Club",
    desc: "Practicing hands-on cybersecurity labs, penetration testing, and defense strategies."
  }
];

const certifications = [
  { name: "Dean's List", issuer: "Rochester Institute of Technology" },
  { name: "Honor Roll Student (All Grades 9-12)", issuer: "White Oaks SS (Jun 2025)" },
  { name: "Certificate of Distinction (Top 25% - CCC)", issuer: "University of Waterloo (Feb 2025)" },
  { name: "Sir Isaac Newton Exam - Distinction (Top 25%)", issuer: "University of Waterloo" },
  { name: "Canadian Senior Math Contest - Distinction", issuer: "University of Waterloo" }
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={pageDescription} />
    <title>{pageTitle}</title>

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:image" content="https://aceiq.ca/_image?href=%2F_astro%2Favatar.CHtb4UzT.jpg&w=730&h=730&f=webp" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary" />
    <meta property="twitter:url" content={Astro.url} />
    <meta property="twitter:title" content={pageTitle} />
    <meta property="twitter:description" content={pageDescription} />
    <meta property="twitter:image" content="https://aceiq.ca/_image?href=%2F_astro%2Favatar.CHtb4UzT.jpg&w=730&h=730&f=webp" />

    <ClientRouter />
  </head>
  <body>
    <Header />
    
    <main class="animate">
      <section class="intro-section">
        <h1>Learn. Challenge. <span class="text-gradient">Apply. Create.</span></h1>
        <div class="story-content animate stagger-1">
          <p>
            My fascination with technology began at age six, when my uncle told me that <strong>"computers run on 1s and 0s."</strong> 
            That single line sparked a lifelong curiosity. From reviving a Windows 95 laptop to founding my own AI solutions company, 
            my path has been defined by a relentless drive to understand how things work at their most fundamental level.
          </p>
          <p>
            Today, as a Computer Science student at <strong>RIT</strong>, I combine rigorous academic study with 
            hands-on experimentation in SOTA AI, high-performance computing, and hardware engineering.
          </p>
        </div>
      </section>

      <div class="about-grid">
        <div class="main-col">
          <section class="section animate stagger-2">
            <h2>Experience</h2>
            {experience.map(exp => (
              <div class="card">
                <div class="card-header">
                  <h3>{exp.role} <span class="at-separator">@</span> <span class="text-gradient">{exp.company}</span></h3>
                </div>
                <div class="card-meta">
                  <span class="date">{exp.period}</span>
                  {exp.location && (
                    <>
                      <span class="meta-separator">&bull;</span>
                      <span class="location">{exp.location}</span>
                    </>
                  )}
                </div>
                <p class="card-desc">{exp.description}</p>
                <ul>
                  {exp.points.map(p => <li>{p}</li>)}
                </ul>
              </div>
            ))}
          </section>

          <section class="section animate stagger-3">
            <h2>Education</h2>
            {education.map(edu => (
              <div class="card">
                <div class="card-header">
                  <h3>{edu.school}</h3>
                </div>
                <div class="card-meta">
                  <span class="date">{edu.period}</span>
                  {edu.location && (
                    <>
                      <span class="meta-separator">&bull;</span>
                      <span class="location">{edu.location}</span>
                    </>
                  )}
                </div>
                <p class="card-desc">{edu.degree} &bull; {edu.gpa}</p>
                <h4 class="edu-sub-title">Extracurriculars</h4>
                <ul>
                  {edu.highlights.map(h => <li>{h}</li>)}
                </ul>
              </div>
            ))}
          </section>
        </div>

        <div class="side-col">
          <section class="section animate stagger-4">
            <h2>Involvement</h2>
            <div class="mini-cards">
              {extraCurriculars.map(ex => (
                <div class="mini-card">
                  <h4>{ex.org}</h4>
                  <p>{ex.role}</p>
                </div>
              ))}
            </div>
          </section>

          <section class="section animate stagger-4" style="animation-delay: 0.5s">
            <h2>Honors</h2>
            <div class="cert-list">
              {certifications.map(cert => (
                <div class="cert-item">
                  <strong>{cert.name}</strong>
                  <span>{cert.issuer}</span>
                </div>
              ))}
            </div>
          </section>
        </div>
      </div>
    </main>

    <Footer />
    
    <style>
      .intro-section {
        margin-bottom: 5rem;
        max-width: 800px;
      }
      .story-content p {
        font-size: 1.2rem;
        line-height: 1.8;
        color: #d6d3d1;
        margin-bottom: 1.5rem;
      }
      
      .about-grid {
        display: grid;
        grid-template-columns: 2fr 1fr;
        gap: 3rem;
      }

      .section h2 {
        font-size: 1.8rem;
        margin-bottom: 2rem;
        border-bottom: 1px solid var(--border-color);
        padding-bottom: 0.5rem;
        display: inline-block;
      }

      .card {
        background: rgba(28, 25, 23, 0.45);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid rgba(255, 255, 255, 0.05);
        box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.37);
        padding: 2rem;
        border-radius: 20px;
        margin-bottom: 2rem;
        transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
      }
      .card:hover {
        transform: translateY(-4px);
        border-color: var(--accent-color);
        box-shadow: 0 10px 30px -10px rgba(249, 115, 22, 0.15);
      }
      .card-header {
        margin-bottom: 0.5rem;
      }
      .card-header h3 { margin: 0; font-size: 1.4rem; }
      .at-separator { color: #78716c; font-size: 1.1rem; margin: 0 0.25rem; font-weight: 400; }
      .card-meta {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-family: var(--font-mono);
        color: #78716c;
        font-size: 0.85rem;
        margin-bottom: 1.25rem;
        flex-wrap: wrap;
      }
      .card-meta .date {
        color: var(--accent-color);
        font-weight: 600;
      }
      .meta-separator {
        color: var(--border-color);
        margin: 0 0.5rem;
      }
      .card-desc { color: #a8a29e; font-weight: 600; margin-bottom: 1rem; }

      ul { padding-left: 1.2rem; }
      li { color: #d6d3d1; margin-bottom: 0.5rem; font-size: 0.95rem; }

      .mini-cards { display: flex; flex-direction: column; gap: 1rem; }
      .mini-card {
        background: rgba(28, 25, 23, 0.3);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid rgba(255, 255, 255, 0.03);
        padding: 1.2rem;
        border-radius: 12px;
        transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
      }
      .mini-card:hover {
        transform: translateY(-2px);
        border-color: var(--accent-color);
        box-shadow: 0 6px 20px -8px rgba(249, 115, 22, 0.15);
      }
      .mini-card h4 { margin: 0; font-size: 1rem; color: var(--accent-color); }
      .mini-card p { margin: 0.25rem 0 0 0; font-size: 0.9rem; color: #a8a29e; }

      .cert-list { display: flex; flex-direction: column; gap: 1.2rem; }
      .cert-item { display: flex; flex-direction: column; font-size: 0.9rem; }
      .cert-item strong { color: #e7e5e4; }
      .cert-item span { color: #78716c; font-family: var(--font-mono); }
      
      .edu-sub-title {
        color: var(--accent-color);
        font-family: var(--font-mono);
        font-size: 0.9rem;
        margin-top: 1rem;
        margin-bottom: 0.5rem;
        text-transform: uppercase;
        letter-spacing: 0.05rem;
      }

      @media (max-width: 900px) {
        .about-grid { grid-template-columns: 1fr; }
      }

      @media (max-width: 600px) {
        .card {
          padding: 1.25rem;
        }
      }
    </style>
  </body>
</html>
