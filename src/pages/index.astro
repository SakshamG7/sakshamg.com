---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { ClientRouter } from 'astro:transitions';
const pageTitle = "Saksham Goel | CS @ RIT";
const pageDescription = "Saksham Goel's personal website featuring AI research, software engineering projects, and updates from his Computer Science journey at RIT.";
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={pageDescription} />
		<title>{pageTitle}</title>

		<!-- Open Graph / Facebook -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={Astro.url} />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={pageDescription} />
		<meta property="og:image" content="https://aceiq.ca/_image?href=%2F_astro%2Favatar.CHtb4UzT.jpg&w=730&h=730&f=webp" />

		<!-- Twitter -->
		<meta property="twitter:card" content="summary" />
		<meta property="twitter:url" content={Astro.url} />
		<meta property="twitter:title" content={pageTitle} />
		<meta property="twitter:description" content={pageDescription} />
		<meta property="twitter:image" content="https://aceiq.ca/_image?href=%2F_astro%2Favatar.CHtb4UzT.jpg&w=730&h=730&f=webp" />

		<ClientRouter />
	</head>
	<body>
		<Header />
		
		<section class="hero animate">
			<div class="hero-content">
				<div class="profile-frame animate stagger-1">
					<img src="https://aceiq.ca/_image?href=%2F_astro%2Favatar.CHtb4UzT.jpg&w=730&h=730&f=webp" alt="Saksham Goel" />
				</div>
				<div class="hero-text">
					<div class="badge animate stagger-1">Software Engineer @ Angstrom &bull; CS @ RIT</div>
					<h1 class="animate stagger-2">Saksham Goel</h1>
					<p class="subtitle animate stagger-3">Software Engineer & <span class="text-gradient">AI Researcher</span></p>
					<p class="description animate stagger-4">
						Software Engineer Intern at <strong>Angstrom NA LLC</strong> and Founder & CEO of <strong>AceIQ</strong>. 
						Studying Computer Science at <strong>RIT</strong>, specializing in AI/ML, autonomous agents, and high-performance backend systems.
					</p>
					<div class="cta-group animate stagger-4">
						<a href="/projects/" class="btn">View Projects</a>
						<a href="/about/" class="btn secondary">Full Story</a>
					</div>
				</div>
			</div>
		</section>

		<section class="stats-row animate stagger-4">
			<div class="stat-item">
				<span class="stat-value">5+</span>
				<span class="stat-label">Businesses Built</span>
			</div>
			<div class="stat-divider"></div>
			<div class="stat-item">
				<span class="stat-value">2500+</span>
				<span class="stat-label">AceChess Elo</span>
			</div>
			<div class="stat-divider"></div>
			<div class="stat-item">
				<span class="stat-value">3+</span>
				<span class="stat-label">Work Experiences</span>
			</div>
		</section>

		<section class="motto-strip animate">
			<div class="motto-container">
				<span class="motto-item">Learn</span>
				<span class="motto-separator">&bull;</span>
				<span class="motto-item">Challenge</span>
				<span class="motto-separator">&bull;</span>
				<span class="motto-item">Apply</span>
				<span class="motto-separator">&bull;</span>
				<span class="motto-item">Create</span>
			</div>
		</section>

		<section class="featured-projects animate">
			<div class="section-header">
				<h2>Core <span class="text-gradient">Innovations</span></h2>
				<a href="/projects/" class="view-all">See all projects &rarr;</a>
			</div>
			<div class="project-grid">
				<div class="project-card animate stagger-1">
					<div class="card-glow"></div>
					<span class="category">Systems Engineering</span>
					<h3>GammaWave</h3>
					<p>High-performance GBA/GBC/GB emulator with a native C/C++ FFI core translation layer and a responsive skin engine.</p>
					<div class="tags">
						<span class="tag">Flutter</span>
						<span class="tag">C/C++ FFI</span>
					</div>
				</div>
				<div class="project-card animate stagger-2">
					<div class="card-glow"></div>
					<span class="category">AI Engineering</span>
					<h3>AceChess</h3>
					<p>NN Chess Engine inspired by AlphaZero. Features a custom MoE & ResNet architecture for lightning-fast inference.</p>
					<div class="tags">
						<span class="tag">PyTorch</span>
						<span class="tag">Reinforcement</span>
					</div>
				</div>
				<div class="project-card animate stagger-3">
					<div class="card-glow"></div>
					<span class="category">Reasoning LLMs</span>
					<h3>AceLM 2B</h3>
					<p>My smartest reasoning model built by modifying Qwen2.5 1.5B into a custom 2B architecture with advanced thinking capabilities.</p>
					<div class="tags">
						<span class="tag">LLM</span>
						<span class="tag">Reasoning</span>
					</div>
				</div>
				<div class="project-card animate stagger-4">
					<div class="card-glow"></div>
					<span class="category">Quantitative Dev</span>
					<h3>AceMarket</h3>
					<p>AI Trading yielding 20-40% annual returns through robust sentiment analysis and market history.</p>
					<div class="tags">
						<span class="tag">ML</span>
						<span class="tag">Finance</span>
					</div>
				</div>
				<div class="project-card animate stagger-1">
					<div class="card-glow"></div>
					<span class="category">Information Retrieval</span>
					<h3>AceSearch</h3>
					<p>Custom search engine and ranking algorithm built to index documents, model link relevance, and optimize query latency.</p>
					<div class="tags">
						<span class="tag">Python</span>
						<span class="tag">PostgreSQL</span>
					</div>
				</div>
				<div class="project-card animate stagger-2">
					<div class="card-glow"></div>
					<span class="category">AI Fine-Tuning</span>
					<h3>UWaterloo AI</h3>
					<p>Fine-tuned Mistral-7B model using LoRA, achieving 98% accuracy on specialized program and university knowledge base questions.</p>
					<div class="tags">
						<span class="tag">Mistral</span>
						<span class="tag">LoRA</span>
					</div>
				</div>
			</div>
		</section>

		<Footer />

		<style>
			.hero {
				padding: 6rem 0;
			}
			.hero-content {
				display: flex;
				align-items: center;
				gap: 5rem;
				flex-wrap: wrap;
			}
			.profile-frame {
				width: 300px;
				max-width: 100%;
				height: auto;
				aspect-ratio: 1 / 1;
				border-radius: 30px;
				overflow: hidden;
				border: 1px solid var(--border-color);
				box-shadow: 0 20px 50px -12px rgba(0, 0, 0, 0.5);
				position: relative;
			}
			.profile-frame::after {
				content: '';
				position: absolute;
				inset: 0;
				border: 2px solid var(--accent-color);
				border-radius: 30px;
				opacity: 0.3;
			}
			.profile-frame img {
				width: 100%;
				height: 100%;
				object-fit: cover;
			}
			.hero-text {
				flex: 1;
				min-width: 300px;
			}
			.badge {
				display: inline-block;
				background: var(--card-bg);
				border: 1px solid var(--border-color);
				padding: 0.5rem 1rem;
				border-radius: 99px;
				font-family: var(--font-mono);
				font-size: 0.8rem;
				color: var(--accent-color);
				margin-bottom: 1.5rem;
			}
			.subtitle {
				font-size: 1.5rem;
				font-weight: 700;
				color: #e7e5e4;
				margin: -1rem 0 1.5rem 0;
			}
			.description {
				font-size: 1.25rem;
				line-height: 1.8;
				color: #a8a29e;
				margin-bottom: 2.5rem;
				max-width: 650px;
			}
			.cta-group {
				display: flex;
				gap: 1.5rem;
			}
			.btn {
				background: linear-gradient(135deg, var(--accent-color), var(--accent-secondary));
				color: #fff;
				padding: 1rem 2.5rem;
				border-radius: 12px;
				font-weight: 700;
				transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
				display: inline-block;
				box-shadow: 0 4px 15px rgba(249, 115, 22, 0.25);
			}
			.btn.secondary {
				background: transparent;
				color: #fff;
				border: 1px solid var(--border-color);
				box-shadow: none;
			}
			.btn:hover {
				transform: translateY(-3px);
				box-shadow: 0 10px 22px -5px rgba(249, 115, 22, 0.45);
				filter: brightness(1.1);
			}
			.btn.secondary:hover {
				background: rgba(255, 255, 255, 0.03);
				border-color: var(--accent-color);
				box-shadow: 0 10px 20px -5px rgba(249, 115, 22, 0.15);
				filter: none;
			}

			.stats-row {
				display: flex;
				justify-content: space-between;
				align-items: center;
				background: rgba(28, 25, 23, 0.45);
				backdrop-filter: blur(12px);
				-webkit-backdrop-filter: blur(12px);
				border: 1px solid rgba(255, 255, 255, 0.05);
				box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.37);
				padding: 3rem;
				border-radius: 24px;
				margin: 4rem 0;
			}
			.stat-item {
				text-align: center;
				flex: 1;
			}
			.stat-value {
				display: block;
				font-size: 2.5rem;
				font-weight: 800;
				color: #fff;
			}
			.stat-label {
				font-family: var(--font-mono);
				font-size: 0.8rem;
				text-transform: uppercase;
				color: #78716c;
				letter-spacing: 0.1rem;
			}
			.stat-divider {
				width: 1px;
				height: 50px;
				background: var(--border-color);
			}

			.motto-strip {
				margin: 6rem 0;
				text-align: center;
			}
			.motto-container {
				display: flex;
				justify-content: center;
				align-items: center;
				flex-wrap: wrap;
				gap: 0.5rem 2rem;
				font-family: var(--font-mono);
				font-size: 2rem;
				font-weight: 800;
				letter-spacing: 0.3rem;
				text-transform: uppercase;
			}
			.motto-separator {
				color: var(--accent-color);
			}

			.section-header {
				display: flex;
				justify-content: space-between;
				align-items: flex-end;
				margin-bottom: 3rem;
			}
			.view-all {
				font-family: var(--font-mono);
				font-weight: 600;
				font-size: 0.9rem;
			}
			
			.category {
				font-family: var(--font-mono);
				font-size: 0.7rem;
				text-transform: uppercase;
				color: var(--accent-color);
				letter-spacing: 0.1rem;
				margin-bottom: 0.5rem;
				display: block;
			}

			@media (max-width: 768px) {
				.hero {
					padding: 3rem 0;
				}
				.hero-content {
					flex-direction: column;
					text-align: center;
					gap: 3rem;
				}
				.hero-text {
					min-width: unset;
					width: 100%;
				}
				.badge {
					display: inline-flex;
					justify-content: center;
					text-align: center;
					border-radius: 16px;
					line-height: 1.4;
					max-width: 100%;
					font-size: 0.75rem;
					padding: 0.5rem 1rem;
				}
				.description { margin-inline: auto; }
				.cta-group { 
					flex-direction: column;
					align-items: center;
					gap: 1rem;
					width: 100%;
				}
				.cta-group a {
					width: 100%;
					max-width: 280px;
					text-align: center;
				}
				.stats-row {
					flex-direction: column;
					gap: 2rem;
					padding: 2rem 1.5rem;
					width: calc(100% - 2rem);
					max-width: 400px;
					margin: 3rem auto;
				}
				.stat-divider {
					width: 50%;
					height: 1px;
					background: var(--border-color);
					opacity: 0.4;
					margin: 0 auto;
				}
				.section-header {
					flex-direction: column;
					align-items: center;
					gap: 0.75rem;
					text-align: center;
					margin-bottom: 2rem;
				}
				.motto-container {
					font-size: 1.2rem;
					letter-spacing: 0.15rem;
					gap: 0.5rem 1rem;
				}
				.motto-separator {
					display: none;
				}
				.motto-strip {
					margin: 3rem 0;
				}
			}
		</style>
	</body>
</html>
